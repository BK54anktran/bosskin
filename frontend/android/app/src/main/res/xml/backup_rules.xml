<?xml version="1.0" encoding="utf-8"?>
<!-- Android ≤ 11: không sao lưu kho khoá của flutter_secure_storage — khoá giải mã nằm trong Keystore của lần cài đó,
     khôi phục sang lần cài khác thì không đọc được và làm hỏng việc lưu phiên đăng nhập. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
