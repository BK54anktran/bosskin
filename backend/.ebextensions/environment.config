# Elastic Beanstalk (Java SE). Gói deploy = bosskin-1.0.0.jar + Procfile + .ebextensions (xem deploy.yml).
# Biến môi trường thật (DB_URL, JWT_SECRET, …) đặt trong Environment properties / SSM — xem docs/runbook.md.
option_settings:
  aws:elasticbeanstalk:application:
    # Bước 2: health check của EB / load balancer gọi endpoint này (UP khi app chạy và kết nối được DB)
    Application Healthcheck URL: /actuator/health
  aws:elasticbeanstalk:application:environment:
    # App nghe cổng PORT (application-prod.yml); nginx của EB proxy vào 5000
    PORT: 5000
