# Sao chép thành backend/.env khi chạy local (file .env không commit).
# Trên Elastic Beanstalk đặt các biến này trong Environment properties / SSM.

# --- Bắt buộc trên server (local: bỏ dấu # nếu khác mặc định trong application.yml; để dạng chú thích vì Vibe Host quét file này để đoán CSDL) ---
# DB_URL=jdbc:mysql://localhost:3306/bosskin?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
# DB_USERNAME=bosskin
# DB_PASSWORD=bosskin123
# Ngẫu nhiên, >= 32 ký tự. Tạo: openssl rand -base64 48
JWT_SECRET=

# --- Lần chạy đầu trên DB trống: tạo system admin (mật khẩu >= 12 ký tự) ---
BOOTSTRAP_SYSADMIN_EMAIL=
BOOTSTRAP_SYSADMIN_PASSWORD=

# --- Tuỳ chọn (bỏ dấu # ở dòng cần dùng; để dạng chú thích vì nền tảng quét file này coi khoá trống là bắt buộc) ---
# Origin bản web được gọi API (phân tách dấu phẩy). Mặc định cho phép localhost mọi cổng.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Khoá Firebase (push): đường dẫn file HOẶC nội dung JSON/base64. Không đặt thì tắt push.
# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# S3 lưu ảnh/tài liệu/lịch sử Excel
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=
# Tài liệu nhân sự: s3 | local (trống = s3 khi có bucket). local lưu ở DOCUMENTS_LOCAL_DIR (mặc định ~/.bosskin/documents)
DOCUMENTS_STORAGE=
MAP_TILE_USER_AGENT=BossKin-HR/1.0 (lien-he@ten-mien.vn)
